# Copy this to /opt/openproject-dev/.env on the server and fill in real values.
# Generate fresh secrets with:  openssl rand -hex 32

# --- Image ---
# These two are normally overridden by the GitHub Actions deploy step.
# Defaults are only used when you run `docker compose up -d` manually on the server.
OPENPROJECT_IMAGE=ghcr.io/excelerate-technologies/xira-custom
OPENPROJECT_TAG=latest

# --- Rails ---
SECRET_KEY_BASE=replace-me-with-openssl-rand-hex-32
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16

# --- App URL / proxy ---
OPENPROJECT_HOST__NAME=xira-dev.exceleratetechnologies.com
OPENPROJECT_HTTPS=true
OPENPROJECT_HSTS=true
PORT=8082
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=

# --- Azure PostgreSQL (use a SEPARATE database from prod) ---
DB_POSTGRESDB_HOST=cex-db.postgres.database.azure.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=op_xira_dev
DB_POSTGRESDB_USER=cx_pg_admin
# IMPORTANT: URL-encode special characters in the password.
# The compose file builds DATABASE_URL as postgres://user:pass@host/db, so the
# password is interpolated into a URI. Characters that have meaning in a URI
# must be percent-encoded:
#   @ -> %40    : -> %3A    / -> %2F    # -> %23    ? -> %3F
#   space -> %20    & -> %26    = -> %3D    + -> %2B
# Example: a literal password "SecurePasswordCEX@1" must be written as
#   DB_POSTGRESDB_PASSWORD=SecurePasswordCEX%401
DB_POSTGRESDB_PASSWORD=replace-me-url-encoded

# --- Bind mount for uploads/attachments ---
OPDATA=/opt/openproject-dev/opdata

# --- Collaborative editing (Hocuspocus) ---
COLLABORATIVE_SERVER_URL=wss://xira-dev.exceleratetechnologies.com/hocuspocus
COLLABORATIVE_SERVER_SECRET=replace-me-with-openssl-rand-hex-32

# --- SMTP ---
IMAP_ENABLED=false
OPENPROJECT_SMTP__ADDRESS=smtp.office365.com
OPENPROJECT_SMTP__PORT=587
OPENPROJECT_SMTP__DOMAIN=exceleratetechnologies.com
OPENPROJECT_SMTP__AUTHENTICATION=login
OPENPROJECT_SMTP__USER__NAME=ticketsupport@exceleratetechnologies.com
OPENPROJECT_SMTP__PASSWORD=replace-me
OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=true
OPENPROJECT_MAIL__FROM=ticketsupport@exceleratetechnologies.com
