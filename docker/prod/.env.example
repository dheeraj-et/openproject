# docker/prod/.env.example
# Copy to docker/prod/.env and fill in real values. `.env` is gitignored.
#
# Generate fresh secrets (run twice, paste each):
#   openssl rand -hex 64

# ---- Required secrets ----
SECRET_KEY_BASE=replace-me-with-64-hex-chars
OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__SECRET=replace-me-with-64-hex-chars

# ---- Host & protocol ----
# The public URL host:port users type in the browser.
OPENPROJECT_HOST__NAME=localhost:8080
OPENPROJECT_HTTPS=false
OPENPROJECT_DEFAULT__LANGUAGE=en

# ---- Port mappings (host side) ----
# Web UI: http://localhost:${WEB_PORT}
WEB_PORT=8080
# Bundled Postgres exposed to the host for pgAdmin etc.
# Using 55432 by default to avoid clashing with a local Postgres install.
POSTGRES_PORT=55432

# ---- Data volumes (host paths) ----
# Bind-mount host dirs so data survives container re-creation.
PGDATA_HOST_PATH=/c/Users/DP/openproject-data/pgdata
ASSETS_HOST_PATH=/c/Users/DP/openproject-data/assets

# ---- Image ----
# The locally-built all-in-one image. Rebuild after code changes (see README-LOCAL.md).
OPENPROJECT_IMAGE=openproject-custom:local
